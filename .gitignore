# --- shared by every sapphire-turtle repository (sapphire-framework/ci/templates/.gitignore) ---

# Generated by Cargo
debug
target

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# Agent and tooling scratch: Claude Code settings and worktrees, the
# subagent-driven-development ledger, local git worktrees
.claude
.superpowers/
.worktrees/

# macOS Finder metadata
.DS_Store

# --- repository specific ---

# The demo's mobile builds (demo/README.md): the generated Xcode project and its build
# output, the developer's own signing settings, the Gradle build and the Rust libraries
# copied into it.
/demo/ios/CorundumDemo.xcodeproj
/demo/ios/Info.plist
/demo/ios/build
/demo/ios/Local.xcconfig
/demo/ios/*.log
/demo/android/.gradle
/demo/android/local.properties
/demo/android/app/build
/demo/android/build
/demo/android/app/src/main/jniLibs
